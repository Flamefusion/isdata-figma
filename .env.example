# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=rings_auth
DB_USER=postgres
DB_PASSWORD=password
